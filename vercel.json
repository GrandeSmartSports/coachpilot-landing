        {
          "type": "host",
          "value": "go.blslittleleague.org"
        }
      ],
      "destination": "/south-hill/",
      "permanent": false
    },
    {
      "source": "/:path((?!fields|bls/|bls-south-hill/|website-updates/|south-hill/|favicon\\.ico$|robots\\.txt$).*)",
      "has": [
        {
          "type": "host",
          "value": "go.blslittleleague.org"
        }
      ],
      "destination": "https://www.blslittleleague.org/",
      "permanent": false
    },
    {
      "source": "/fields",
      "destination": "/fields/",
      "permanent": false
    },
    {
      "source": "/sophie",
      "destination": "/sophie/",
      "permanent": false
    },
    {
      "source": "/sophie/coach",
      "destination": "/sophie/coach/",
      "permanent": false
    },
    {
      "source": "/bls/website-updates",
      "destination": "/bls/website-updates/",
      "permanent": false
    },
    {
      "source": "/bls/remind",
      "destination": "/bls/remind/",
